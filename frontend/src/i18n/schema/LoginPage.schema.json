{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Welcome message"
    },
    "form": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "description": "Username input label"
            },
            "password": {
              "type": "string",
              "description": "Password input label"
            }
          },
          "required": ["username", "password"]
        },
        "placeholders": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "description": "Username input placeholder"
            },
            "password": {
              "type": "string",
              "description": "Password input placeholder"
            }
          },
          "required": ["username", "password"]
        },
        "buttons": {
          "type": "object",
          "properties": {
            "login": {
              "type": "string",
              "description": "Login button text"
            },
            "signup": {
              "type": "string",
              "description": "Signup button text"
            }
          },
          "required": ["login", "signup"]
        },
        "aria": {
          "type": "object",
          "properties": {
            "showPassword": {
              "type": "string",
              "description": "Aria label for show password button"
            }
          },
          "required": ["showPassword"]
        }
      },
      "required": ["labels", "placeholders", "buttons", "aria"]
    },
    "signup": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "Text asking if user doesn't have an account"
        }
      },
      "required": ["question"]
    }
  },
  "required": ["title", "form", "signup"]
}
