{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hot topic translation schema",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_]+$": {
      "type": "object",
      "properties": {
        "topic": { "type": "string" },
        "description": { "type": "string" },
        "subDescription": { "type": "string" }
      },
      "required": ["topic", "description", "subDescription"],
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": { "type": "string" }
  },
  "additionalProperties": false
}
