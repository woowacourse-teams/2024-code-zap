{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "object",
      "properties": {
        "invalid": {
          "type": "string",
          "description": "Error message for invalid name"
        }
      },
      "required": ["invalid"]
    },
    "password": {
      "type": "object",
      "properties": {
        "invalid": {
          "type": "string",
          "description": "Error message for invalid password"
        },
        "mismatch": {
          "type": "string",
          "description": "Error message for mismatched password confirmation"
        }
      },
      "required": ["invalid", "mismatch"]
    }
  },
  "filename": {
      "type": "object",
      "properties": {
        "tooLong": {
          "type": "string",
          "description": "Error message when filename is too long"
        },
        "invalidChars": {
          "type": "string",
          "description": "Error message when filename contains invalid characters"
        }
      },
      "required": ["tooLong", "invalidChars"]
    },
  "sourceCode": {
      "type": "object",
      "properties": {
        "tooLong": {
          "type": "string",
          "description": "Error message when source code is too long"
        },
        "invalidExtension": {
          "type": "string",
          "description": "Error message when file extension is not supported"
        }
      },
      "required": ["tooLong", "invalidExtension"]
    },
    "category": {
      "type": "object",
      "properties": {
        "invalid": {
          "type": "string",
          "description": "Error message for invalid category name"
        }
      },
      "required": ["invalid"]
    },
    "tag": {
      "type": "object",
      "properties": {
        "tooLong": {
          "type": "string",
          "description": "Error message when tag is too long"
        }
      },
      "required": ["tooLong"]
    },
    "email": {
      "type": "object",
      "properties": {
        "invalid": {
          "type": "string",
          "description": "Error message for invalid email format"
        }
      },
      "required": ["invalid"]
    },
    "template": {
      "type": "object",
      "properties": {
        "titleRequired": {
          "type": "string",
          "description": "Error message when template title is required"
        },
        "sourceCodeRequired": {
          "type": "string",
          "description": "Error message when source code is required"
        }
      },
      "required": ["titleRequired", "sourceCodeRequired"]
    },
  "required": ["name", "password", "filename", "sourceCode", "category", "tag", "email", "template"]
}
